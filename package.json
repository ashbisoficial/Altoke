    "fractional-indexing": "^3.4.0",
    "lucide-react": "^1.33.0",
    "next": "^15.5.23",
    "prisma": "^6.19.3",
    "react": "^18",
    "react-dom": "^18",
    "react-markdown": "^9.1.0",
    "remark-gfm": "^4.0.1",
