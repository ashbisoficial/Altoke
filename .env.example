# Firebase client config (Consola de Firebase -> Configuración del proyecto ->
# tus apps -> app web -> "Configuración del SDK" -> "Config"). Estos valores
# son públicos (van al bundle del navegador), no son secretos.
NEXT_PUBLIC_FIREBASE_API_KEY="xxxxx"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="tu-proyecto.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="tu-proyecto"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="tu-proyecto.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="xxxxx"
NEXT_PUBLIC_FIREBASE_APP_ID="xxxxx"

# Credenciales del Admin SDK (privilegiado, SOLO servidor — nunca exponer al
# cliente). Consola de Firebase -> Configuración del proyecto -> Cuentas de
# servicio -> "Generar nueva clave privada" descarga un JSON con estos tres
# campos (project_id, client_email, private_key). Pegá private_key tal cual
# viene en el JSON, con los \n literales — el código los convierte a saltos
# de línea reales.
FIREBASE_PROJECT_ID="tu-proyecto"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@tu-proyecto.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nxxxxx\n-----END PRIVATE KEY-----\n"

# Resend (https://resend.com, free tier) — envío del correo real de
# invitación. Si se deja vacío, las invitaciones siguen funcionando con el
# enlace para compartir, solo que sin el correo automático.
RESEND_API_KEY=""

# Public site URL, usado para los enlaces de auth (email link / magic link)
# y para armar los enlaces de invitación.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
