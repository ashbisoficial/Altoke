# ---------------------------------------------------------------------------
# Firebase (autenticación). Ver docs/firebase.md.
# Configuración pública de la app web (Firebase console > Configuración del proyecto).
NEXT_PUBLIC_FIREBASE_API_KEY="xxxxx"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="altoke-xxxxx.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="altoke-xxxxx"
NEXT_PUBLIC_FIREBASE_APP_ID="1:000000000000:web:xxxxx"

# Servidor (SECRETO, nunca en el navegador). Una de estas dos formas:
#   a) JSON completo de la cuenta de servicio, en una sola línea:
FIREBASE_SERVICE_ACCOUNT_JSON=""
#   b) Campos sueltos:
FIREBASE_PROJECT_ID="altoke-xxxxx"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@altoke-xxxxx.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nxxxxx\n-----END PRIVATE KEY-----\n"

# Desarrollo local con el emulador (npm run emulators). Si se define, no hacen falta credenciales.
# FIREBASE_AUTH_EMULATOR_HOST="127.0.0.1:9099"
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_URL="http://127.0.0.1:9099"

# ---------------------------------------------------------------------------
# Base de datos: Postgres (pendiente de migrar a Firestore). Ver docs/firebase.md.
DATABASE_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------------------
# Supabase: solo almacenamiento de archivos y tiempo real del mural.
NEXT_PUBLIC_SUPABASE_URL="https://xxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="xxxxx"
# Clave de servicio: solo servidor. Las subidas pasan por /api/uploads.
SUPABASE_SERVICE_ROLE_KEY="xxxxx"

# URL pública del sitio (enlaces de invitación)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Ambiente: "production" bloquea los scripts de datos de QA (seed:qa).
ALTOKE_ENV="staging"

# Contraseña compartida de los usuarios de QA (seed:qa con Firebase Auth real).
QA_PASSWORD="cambiar-en-staging"
