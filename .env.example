# Supabase Postgres connection (Project Settings -> Database -> Connection string)
# Use the pooled connection (port 6543, pgbouncer) for the app, and the direct
# connection (port 5432) for migrations.
DATABASE_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"

# Supabase project API settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL="https://xxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="xxxxx"
# Secret key (Project Settings -> API Keys -> "Secret keys"). Required to send
# invitation emails (supabase.auth.admin.inviteUserByEmail) — never expose this
# to the browser. Without it, invitations still work via the shareable link,
# they just skip the automatic email.
SUPABASE_SERVICE_ROLE_KEY="xxxxx"

# Public site URL, used for auth redirects (magic link, etc.)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
